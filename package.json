{
  "name": "event-planner",
  "version": "1.0.0",
  "private": true,
  "description": "GenAI planning assistant for weddings, birthdays and community events: budgets, timelines, vendor checklists and personalized ideas.",
  "type": "module",
  "engines": {
    "node": ">=20.6"
  },
  "scripts": {
    "dev": "node --env-file=.env --watch scripts/dev-server.js",
    "start": "node --env-file=.env scripts/dev-server.js",
    "lint": "eslint .",
    "test": "node --test \"test/**/*.test.js\"",
    "test:coverage": "node --test --experimental-test-coverage \"test/**/*.test.js\""
  },
  "dependencies": {
    "@google/genai": "^2.30.0",
    "resend": "^6.34.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "express": "^5.3.0",
    "globals": "^17.13.0"
  }
}
